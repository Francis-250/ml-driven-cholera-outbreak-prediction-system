generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String      @id
  name                   String
  email                  String
  emailVerified          Boolean     @default(false)
  image                  String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  role                   String?
  banned                 Boolean?    @default(false)
  banReason              String?
  banExpires             DateTime?
  phoneNumber            String?
  phoneNumberVerified    Boolean?
  username               String?
  displayUsername        String?
  twoFactorEnabled       Boolean?    @default(false)
  aiDailyAssessmentLimit Int?
  sessions               Session[]
  accounts               Account[]
  twofactors             TwoFactor[]

  staffProfile       StaffProfile?
  assessments        Assessment[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  aiUsageLogs        AiUsageLog[]
  environmentalData  EnvironmentalData[] @relation("UserEnvironmentalData")

  @@unique([email])
  @@unique([phoneNumber])
  @@unique([username])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean? @default(true)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

enum UserRole {
  ADMIN
  STAFF
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum DehydrationLevel {
  NONE
  SOME
  SEVERE
}

enum CaseValidationStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum CaseType {
  FIELD_REPORT
  CLINICAL_CASE
}

enum NotificationStatus {
  UNREAD
  READ
}

enum NotificationType {
  ASSESSMENT_RESULT
  STAFF_ALERT
  HIGH_RISK_ALERT
  OUTBREAK_ALERT
  SYSTEM
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  USER_BANNED
  USER_UNBANNED
  PASSWORD_RESET
  EMAIL_VERIFIED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  ASSESSMENT_CREATED
  ASSESSMENT_VIEWED
  ASSESSMENT_DELETED
  STAFF_VERIFIED
  ADMIN_USER_DELETED
  ADMIN_ROLE_CHANGED
  ADMIN_DATASET_UPLOADED
  AI_ASSESSMENT_TRIGGERED
  AI_CLASSIFICATION_TRIGGERED
  NOTIFICATION_SENT
  NOTIFICATION_READ
  AI_LIMIT_UPDATED
  DISEASE_CASE_CREATED
  DISEASE_CASE_VALIDATED
  ENVIRONMENTAL_DATA_UPLOADED
  REPORT_EXPORTED
}

enum AiModel {
  LLAMA_3_3_70B
  LLAMA_3_1_8B
}

enum AiCallType {
  STREAM_ASSESSMENT
  RISK_CLASSIFICATION
}

enum AiCallStatus {
  SUCCESS
  FAILED
  TIMEOUT
}

enum AssessmentStatus {
  PENDING
  COMPLETED
  REVIEWED
  FLAGGED
}

model StaffProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization          String?
  hospitalName            String?
  licenseNumber           String?   @unique
  isVerified              Boolean   @default(true)
  verifiedAt              DateTime?
  isApprovedByAdmin       Boolean   @default(true)
  approvedByAdminAt       DateTime?
  approvalRejectedAt      DateTime?
  approvalRejectionReason String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("staff_profile")
}

model Assessment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Cholera Clinical & Epidemic Surveillance Fields
  patientName       String?
  district          String?              @default("Gasabo")
  waterSource       String?              @default("Municipal Tap")
  stoolType         String?              // e.g. "Rice-water watery stool", "Loose watery", "Soft"
  dehydrationLevel  DehydrationLevel?    @default(SOME)
  caseType          CaseType?            @default(CLINICAL_CASE)
  validationStatus  CaseValidationStatus @default(PENDING)
  validatedById     String?
  validatedAt       DateTime?
  validationNotes   String?              @db.Text
  patientAge        Int?
  patientGender     String?

  symptoms          Json
  symptomsText      String?              @db.Text

  riskLevel         RiskLevel
  confidenceScore   Float
  detectedSymptoms  Json
  fastScore         Int                  @default(0)
  choleraRiskScore  Int                  @default(0)
  requiresEmergency Boolean              @default(false)
  aiResponse        String               @db.Text
  recommendation    String               @db.Text

  status            AssessmentStatus     @default(COMPLETED)
  reviewedByStaff   Boolean              @default(false)
  reviewedAt        DateTime?

  ipAddress         String?
  userAgent         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  notifications     Notification[]
  aiUsageLogs       AiUsageLog[]

  @@index([userId])
  @@index([riskLevel])
  @@index([district])
  @@index([validationStatus])
  @@index([status])
  @@index([createdAt])
  @@map("assessment")
}

model Notification {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment?        @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  type         NotificationType
  title        String
  message      String             @db.Text
  status       NotificationStatus @default(UNREAD)
  readAt       DateTime?
  createdAt    DateTime           @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notification")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  entity      String?
  entityId    String?
  description String?     @db.Text
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model AiUsageLog {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  model    AiModel
  callType AiCallType
  status   AiCallStatus

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  totalTokens      Int @default(0)

  latencyMs    Int     @default(0)
  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([assessmentId])
  @@index([model])
  @@index([callType])
  @@index([status])
  @@index([createdAt])
  @@map("ai_usage_log")
}

model AiDataset {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  fileName    String
  fileUrl     String
  recordCount Int      @default(0)
  isActive    Boolean  @default(true)
  uploadedBy  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ai_dataset")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_setting")
}

model EnvironmentalData {
  id                      String    @id @default(cuid())
  district                String
  location                String?
  waterSource             String    // Tap, Shallow Well, River, Borehole, Tanker, Lake
  waterContaminationLevel String    // SAFE, MODERATE, HIGH, CRITICAL
  chlorineResidual        Float?    // mg/L (WHO target >= 0.5 mg/L at source)
  sanitationScore         Float?    // 0 - 100
  rainfallMm              Float?    // mm
  temperature             Float?    // Celsius
  turbidityNtu            Float?    // NTU
  phLevel                 Float?    // pH
  floodRisk               Boolean   @default(false)
  outbreakRiskScore       Float     @default(0.0) // 0 - 100
  riskLevel               RiskLevel @default(LOW)
  notes                   String?   @db.Text
  uploadedByUserId        String
  uploadedBy              User      @relation("UserEnvironmentalData", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([district])
  @@index([riskLevel])
  @@index([createdAt])
  @@map("environmental_data")
}
